HOST= # optional, defaults to "0.0.0.0"
PORT= # optional, defaults to "8080"

# Public hostname (must equal CloudFront domain host)

PUBLIC_HOST=cdn.example.com

# Leave empty to run plain HTTP behind a TLS-terminating reverse proxy. Set both: the server serves HTTPS directly.

TLS_CERT_FILE= # optional
TLS_KEY_FILE=  # optional

S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=my-bucket
S3_REGION=garage

# Maximum size of a served object body in bytes (0 disables the limit).

MAX_RESPONSE_BYTES= # optional, defaults to "10485760"

# Signed-cookie verification

CLOCK_SKEW_SECONDS= # optional, defaults to "60"
MIN_RSA_KEY_BITS=   # optional, defaults to "2048"

# Treat all requests as HTTPS regardless of connection. Enable when running behind a TLS-terminating reverse proxy;
# disable only if TLS is handled by this service itself.

FORCE_SCHEME_HTTPS= # optional, defaults to "true"

TRUSTED_SIGNERS= # optional, but you will probably want to set this (e.g., APKA1=/path/to/public.pem)
