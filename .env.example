HOST=0.0.0.0
PORT=8080

# Public hostname (must equal CloudFront domain host)
PUBLIC_HOST=cdn.example.com
# Cookie domain. Must be the same root domain
COOKIE_DOMAIN=.example.com

TLS_CERT_FILE=/path/to/fullchain.pem
TLS_KEY_FILE=/path/to/privkey.pem

S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=my-bucket
S3_REGION=garage

INCLUDE_REGION_IN_PATH=false

# Signed-cookie verification
CLOCK_SKEW_SECONDS=60

TRUSTED_SIGNERS=APKA1=/path/to/public.pem
